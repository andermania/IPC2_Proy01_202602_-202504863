<?xml version="1.0"?>
<configuracion>
  <listaCiudades>

    <!-- Ciudad con una unica entrada; la unica ruta de salida esta bloqueada
         por una unidad militar, asi que la mision de rescate (ChapinRescue,
         no puede combatir) siempre debe dar "Mision Imposible" aqui. Sirve
         para probar ese caso de borde. La extraccion SI es posible con un
         robot lo bastante fuerte (ver robot06 mas abajo). -->
    <ciudad>
      <nombre filas="10" columnas="12">Xelaju</nombre>
      <fila numero="1">"************"</fila>
      <fila numero="2">"*E         *"</fila>
      <fila numero="3">"********** *"</fila>
      <fila numero="4">"********** *"</fila>
      <fila numero="5">"********** *"</fila>
      <fila numero="6">"********** *"</fila>
      <fila numero="7">"**R        *"</fila>
      <fila numero="8">"********** *"</fila>
      <fila numero="9">"**********C*"</fila>
      <fila numero="10">"************"</fila>

      <unidadMilitar fila="2" columna="6">20</unidadMilitar>
      <unidadMilitar fila="7" columna="7">35</unidadMilitar>
      <unidadMilitar fila="5" columna="11">15</unidadMilitar>
    </ciudad>

    <!-- Ciudad con 2 entradas y 2 unidades civiles (para probar la seleccion
         de objetivo cuando hay mas de uno), y un solo recurso alcanzable
         desde cualquiera de las dos entradas, cada una con su propia
         unidad militar en el camino. -->
    <ciudad>
      <nombre filas="7" columnas="9">Peten</nombre>
      <fila numero="1">"*********"</fila>
      <fila numero="2">"*E  R  E*"</fila>
      <fila numero="3">"* ***** *"</fila>
      <fila numero="4">"* ***** *"</fila>
      <fila numero="5">"* ***** *"</fila>
      <fila numero="6">"*C*****C*"</fila>
      <fila numero="7">"*********"</fila>

      <unidadMilitar fila="2" columna="3">10</unidadMilitar>
      <unidadMilitar fila="2" columna="7">25</unidadMilitar>
    </ciudad>

    <!-- Ciudad SIN unidades civiles: solo debe aparecer como opcion para
         misiones de extraccion, nunca para misiones de rescate. Tiene 2
         recursos (para probar la seleccion cuando hay mas de uno) y
         ninguna unidad militar. -->
    <ciudad>
      <nombre filas="5" columnas="5">Coban</nombre>
      <fila numero="1">"*****"</fila>
      <fila numero="2">"*E  *"</fila>
      <fila numero="3">"* * *"</fila>
      <fila numero="4">"*R*R*"</fila>
